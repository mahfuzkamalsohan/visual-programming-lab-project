<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../css/pixel_style.css" pickOnBounds="false" prefWidth="1280.0"
    prefHeight="720.0" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Top Level Main Menu Card (Pane holding tablet menu items) -->
        <Pane id="mainMenuBox" fx:id="mainMenuBox" pickOnBounds="false" prefWidth="1280.0"
            prefHeight="720.0" />

        <!-- Multiplayer Sub-Menu Card (Pane holding tablet menu items) -->
        <Pane id="multiplayerMenuBox" fx:id="multiplayerMenuBox" pickOnBounds="false"
            prefWidth="1280.0" prefHeight="720.0" visible="false" managed="false" />

        <!-- Join Co-op Input Card Overlay -->
        <VBox id="joinCoopBox" fx:id="joinCoopBox" visible="false" managed="false"
            alignment="CENTER" spacing="16.0" styleClass="pixel-panel" maxWidth="420.0"
            maxHeight="320.0">
            <padding>
                <Insets top="24.0" right="28.0" bottom="24.0" left="28.0" />
            </padding>
            <children>
                <Label text="JOIN LAN CO-OP" styleClass="pixel-title"
                    style="-fx-font-size: 24px; -fx-text-fill: #ffd700;" />
                <Label text="★ ENTER HOST IP ADDRESS ★" styleClass="pixel-subtitle"
                    style="-fx-font-size: 12px; -fx-text-fill: #d7e77f;" />
                <TextField id="txtHostIp" fx:id="txtHostIp" text="127.0.0.1"
                    prefWidth="320.0" styleClass="pixel-button"
                    style="-fx-alignment: CENTER; -fx-font-size: 16px; -fx-text-fill: #39ff14;" />
                <HBox spacing="16.0" alignment="CENTER">
                    <children>
                        <Button id="btnJoinConnect" fx:id="btnJoinConnect" text="Connect"
                            prefWidth="140.0" prefHeight="40.0" styleClass="pixel-button" />
                        <Button id="btnJoinCancel" fx:id="btnJoinCancel" text="Cancel"
                            prefWidth="140.0" prefHeight="40.0" styleClass="pixel-button" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Settings Card -->
        <VBox id="settingsBox" fx:id="settingsBox" visible="false" managed="false"
            alignment="CENTER_LEFT" spacing="12.0" styleClass="pixel-settings-panel" maxWidth="400.0"
            maxHeight="540.0" translateX="-240.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>
            <children>
                <Label text="SETTINGS" styleClass="pixel-title" style="-fx-font-size: 28px; -fx-text-fill: #6c5139;" />
                <Label text="★ GAME OPTIONS ★" styleClass="pixel-subtitle"
                    style="-fx-font-size: 12px; -fx-text-fill: #6c5139;" />

                <VBox spacing="14.0" alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets top="14.0" />
                    </VBox.margin>
                    <children>
                        <!-- Music Volume Slider Controls -->
                        <VBox spacing="6.0" alignment="CENTER_LEFT">
                            <children>
                                <Label id="lblMusicVolume" fx:id="lblMusicVolume" text="MUSIC VOLUME: 50%"
                                    styleClass="pixel-subtitle" style="-fx-font-size: 11px; -fx-text-fill: #6c5139;" />
                                <Slider id="sliderMusicVolume" fx:id="sliderMusicVolume" min="0.0" max="100.0"
                                    value="50.0" prefWidth="320.0" styleClass="pixel-slider" />
                            </children>
                        </VBox>
                        <Button id="btnToggleFullscreen" fx:id="btnToggleFullscreen"
                            text="Toggle Fullscreen" prefWidth="320.0" prefHeight="40.0"
                            styleClass="pixel-button" />
                        <Button id="btnSettingsBack" fx:id="btnSettingsBack" text="Back"
                            prefWidth="320.0" prefHeight="40.0" styleClass="pixel-button" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- About Card -->
        <VBox id="aboutBox" fx:id="aboutBox" visible="false" managed="false" alignment="CENTER_LEFT"
            spacing="14.0" styleClass="pixel-about-panel" maxWidth="480.0" maxHeight="540.0"
            translateX="-240.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>
            <children>
                <Label text="ABOUT" styleClass="pixel-title"
                    style="-fx-font-size: 28px; -fx-text-fill: #6c5139; -fx-font-family: 'Press Start 2P', 'Monospaced', monospace;" />
                <Label text="★ ECO RESTORATION ★" styleClass="pixel-subtitle"
                    style="-fx-font-size: 13px; -fx-text-fill: #523c28; -fx-font-family: 'Press Start 2P', 'Monospaced', monospace;" />

                <VBox spacing="14.0" alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="[ OBJECTIVE ]"
                                    style="-fx-font-size: 13px; -fx-text-fill: #6c5139; -fx-font-weight: bold; -fx-font-family: 'Press Start 2P', 'Monospaced', monospace;" />
                                <Label text="Clean &amp; restore polluted ecosystems by collecting trash and answering eco quizzes."
                                    style="-fx-font-size: 11px; -fx-text-fill: #361e0b; -fx-font-family: 'Press Start 2P', 'Monospaced', monospace;" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="[ CONTROLS ]"
                                    style="-fx-font-size: 13px; -fx-text-fill: #6c5139; -fx-font-weight: bold; -fx-font-family: 'Press Start 2P', 'Monospaced', monospace;" />
                                <Label text="• Player 1: WASD to Move | SPACE to Interact"
                                    style="-fx-font-size: 11px; -fx-text-fill: #523c28; -fx-font-family: 'Press Start 2P', 'Monospaced', monospace;" wrapText="true" />
                                <Label text="• Player 2: ARROWS to Move | ENTER to Interact"
                                    style="-fx-font-size: 11px; -fx-text-fill: #523c28; -fx-font-family: 'Press Start 2P', 'Monospaced', monospace;" wrapText="true" />
                            </children>
                        </VBox>

                        <Label text="Version: 1.0.0"
                            style="-fx-font-size: 11px; -fx-text-fill: #6c5139; -fx-font-family: 'Press Start 2P', 'Monospaced', monospace;" wrapText="true" />

                        <Button id="btnAboutBack" fx:id="btnAboutBack" text="Back" prefWidth="430.0"
                            prefHeight="40.0" styleClass="pixel-button" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
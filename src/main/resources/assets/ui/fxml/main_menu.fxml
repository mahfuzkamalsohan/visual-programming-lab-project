<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../css/pixel_style.css" prefWidth="1280.0" prefHeight="720.0" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Main Menu Card -->
        <VBox alignment="CENTER_LEFT" spacing="8.0" styleClass="pixel-panel" maxWidth="380.0" maxHeight="540.0" translateX="-240.0">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0" />
            </padding>
            <children>
                <Label text="RESTORATION" styleClass="pixel-title" style="-fx-font-size: 32px;" />
                
                <VBox spacing="6.0" alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                    <children>
                        <Button fx:id="btnSingle" text="Single Player" prefWidth="310.0" prefHeight="36.0" styleClass="pixel-button" />
                        <Button fx:id="btnQuestionTest" text="Question Test Mode" prefWidth="310.0" prefHeight="36.0" styleClass="pixel-button" />
                        <Button fx:id="btnSortingTest" text="Sorting Test Mode" prefWidth="310.0" prefHeight="36.0" styleClass="pixel-button" />
                        <Button fx:id="btnSequentialDemo" text="3-Stage Demo Map" prefWidth="310.0" prefHeight="36.0" styleClass="pixel-button" />
                        <Button fx:id="btnLocalCoop" text="Local Co-Op (2 Players)" prefWidth="310.0" prefHeight="36.0" styleClass="pixel-button" />
                        <Button fx:id="btnHostLan" text="Host LAN Co-Op" prefWidth="310.0" prefHeight="36.0" styleClass="pixel-button" />
                        <Button fx:id="btnJoinLan" text="Join LAN Co-Op" prefWidth="310.0" prefHeight="36.0" styleClass="pixel-button" />
                        <Button fx:id="btnMapGenerator" text="Map Generator (Infinite)" prefWidth="310.0" prefHeight="36.0" styleClass="pixel-button" />
                        <Button fx:id="btnExit" text="Exit" prefWidth="310.0" prefHeight="36.0" styleClass="pixel-button" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
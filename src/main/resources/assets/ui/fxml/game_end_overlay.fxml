<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../css/pixel_style.css" prefWidth="1280.0" prefHeight="720.0" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox alignment="CENTER" spacing="12.0" styleClass="pixel-panel" maxWidth="440.0" maxHeight="340.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>
            <children>
                <Label fx:id="endTitleLabel" text="WORLD RESTORED" styleClass="pixel-title" style="-fx-font-size: 28px;" />
                <Label fx:id="endSubtitleLabel" text="All 3 stages completed successfully!" styleClass="pixel-subtitle" wrapText="true" alignment="CENTER" />
                <VBox spacing="10.0" alignment="CENTER">
                    <VBox.margin>
                        <Insets top="14.0" />
                    </VBox.margin>
                    <children>
                        <Button fx:id="btnRetry" text="Retry" prefWidth="240.0" prefHeight="38.0" styleClass="pixel-button" />
                        <Button fx:id="btnMainMenu" text="Main Menu" prefWidth="240.0" prefHeight="38.0" styleClass="pixel-button" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>

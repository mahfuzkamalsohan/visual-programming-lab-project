<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../css/pixel_style.css" prefWidth="1280.0" prefHeight="720.0" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox alignment="CENTER" spacing="12.0" styleClass="pixel-panel" maxWidth="380.0" maxHeight="320.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
            <children>
                <Label text="GAME PAUSED" styleClass="pixel-title" style="-fx-font-size: 28px;" />
                <Label text="★ ECO RESTORATION MENU ★" styleClass="pixel-subtitle" />
                <VBox spacing="8.0" alignment="CENTER">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                    <children>
                        <Button fx:id="btnResume" text="Resume Game" prefWidth="260.0" prefHeight="38.0" styleClass="pixel-button" />
                        <Button fx:id="btnMainMenu" text="Main Menu" prefWidth="260.0" prefHeight="38.0" styleClass="pixel-button" />
                        <Button fx:id="btnExit" text="Exit Game" prefWidth="260.0" prefHeight="38.0" styleClass="pixel-button" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
